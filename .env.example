# Bookmark Graveyard — environment variables
# Copy this file to .env.local and fill in the values below.
# SETUP.md walks through where to get each one, in order.
# Run `npm run setup` after filling this in — it checks every value, generates the two app secrets, and provisions the database.

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# Copy from https://supabase.com/dashboard/project/<your-project-ref>/settings/api-keys
# (secret / service_role key) — see SETUP.md step 1
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
# Optional, local only: a personal access token (https://supabase.com/dashboard/account/tokens) lets
# `npm run setup` create the tables for you. Never set it on your host.
# SUPABASE_ACCESS_TOKEN=

# --- X (Twitter) OAuth 2.0 app — see SETUP.md step 2 ---
X_CLIENT_ID=your-x-oauth-client-id
X_CLIENT_SECRET=your-x-oauth-client-secret

# --- xAI (Grok) — see SETUP.md step 3 ---
XAI_API_KEY=your-xai-api-key

# --- Voice provider (podcast audio + video transcription) — see SETUP.md step 4 ---
# These are the instance defaults; any user can override them from the Voices panel in the app.
# Optional: "grok" or "elevenlabs". If VOICE_PROVIDER is unset, ElevenLabs is used when
# ELEVENLABS_API_KEY is set, otherwise Grok (XAI_API_KEY is required by the app anyway). If the
# chosen provider is misconfigured, audio briefs are rejected with a message naming the variable
# to fix, and videos fall back to a thumbnail description instead of a transcript.
# VOICE_PROVIDER=grok
# Grok Voice reuses XAI_API_KEY above — no extra account. Host A voice (Alex, the curious
# host); default ara. All 28 built-in voices: GET https://api.x.ai/v1/tts/voices
# GROK_VOICE_HOST_A=ara
# Host B voice (Blake, the analyst); default helios.
# GROK_VOICE_HOST_B=helios
# ElevenLabs — only needed when ElevenLabs is the provider (set explicitly, or auto-selected
# because ELEVENLABS_API_KEY is present). The key is required; the two voice IDs are needed only
# to render audio. Leave them commented out otherwise: with VOICE_PROVIDER unset, any
# ELEVENLABS_API_KEY value (even a placeholder) selects ElevenLabs.
# ELEVENLABS_API_KEY=your-elevenlabs-api-key
# Two voice IDs for the podcast hosts (defaults suggested in SETUP.md)
# ELEVENLABS_VOICE_HOST_A=your-elevenlabs-voice-id-for-host-a
# ELEVENLABS_VOICE_HOST_B=your-elevenlabs-voice-id-for-host-b

# --- App secrets (generate your own — do not share) ---
# AES-256-GCM key used to encrypt X tokens at rest. Must be exactly 32 bytes of hex
# (64 hex characters). Generate with: openssl rand -hex 32
APP_ENCRYPTION_KEY=
# HMAC key used to sign the session cookie. Any long random string works; generate
# the same way: openssl rand -hex 32
SESSION_SECRET=

# --- App config ---
APP_URL=http://localhost:3000
# Comma-separated X user IDs allowed to log in (empty = personal mode: whoever
# completes X login is allowed — fine while it's just you locally).
ALLOWED_X_USER_IDS=
# Optional: one shared password in front of every page (via /gate), for keeping a deployed
# instance unlisted. Unset = no password wall; ALLOWED_X_USER_IDS is the real access control.
# GATE_PASSWORD=

# --- Optional overrides (not required — the code has sane defaults for all of these) ---
# Two-tier Grok model blend; see ARCHITECTURE.md's "Grok model blend" for why.
# XAI_MODEL_FAST=grok-4.3
# XAI_MODEL_SMART=grok-4.7
# Reasoning effort per tier (none | low | medium | high | xhigh); empty = omit the parameter.
# XAI_REASONING_FAST=none
# XAI_REASONING_SMART=medium
# ElevenLabs TTS model used to render the podcast audio (elevenlabs provider only).
# ELEVENLABS_MODEL=eleven_turbo_v2_5
# Required to enable the Vercel cron endpoint (/api/cron/sync) — without it the
# route stays disabled (503) even in production. Generate a long random value.
# CRON_SECRET=
# Supabase free-tier file storage in bytes (1 GiB): warn at 80%, prune the oldest audio at 90%.
# STORAGE_LIMIT_BYTES=1073741824
# Free-tier database in bytes (500 MiB): warn only, never pruned.
# DATABASE_LIMIT_BYTES=524288000
# Set false to only warn; audio uploads are then refused when storage is full.
# AUTO_PRUNE_AUDIO=true
# Newest briefs per person whose audio is never pruned.
# KEEP_RECENT_AUDIO=4
